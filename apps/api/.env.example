# ── Local development (docker-compose Postgres) ──────────────────────────
# Uses the discrete DB_* vars below. Leave DATABASE_URL unset locally.
DB_HOST=localhost
DB_PORT=5433
DB_USER=wedding
DB_PASSWORD=wedding
DB_NAME=wedding

# ── Production (Supabase Postgres) ───────────────────────────────────────
# When DATABASE_URL is set it takes precedence over the DB_* vars above and
# SSL is enabled automatically (required by Supabase).
# Supabase → Project Settings → Database → Connection string → URI.
# Use the pooled connection (port 6543) for most hosts:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── HTTP server ──────────────────────────────────────────────────────────
# Port the API listens on (managed hosts inject their own PORT).
PORT=3001
# Comma-separated list of allowed browser origins (no trailing slash / path).
# Local Vite dev server:
CORS_ORIGIN=http://localhost:5173
# Production example (GitHub Pages):
# CORS_ORIGIN=https://<your-user>.github.io
