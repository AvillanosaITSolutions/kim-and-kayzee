# ── Local development (docker-compose Postgres) ──────────────────────────
# The api reads these discrete DB_* vars. `pnpm db:up` starts Postgres on 5433.
DB_HOST=localhost
DB_PORT=5433
DB_USER=wedding
DB_PASSWORD=wedding
DB_NAME=wedding

# ── Production (VPS) ─────────────────────────────────────────────────────
# On the VPS these DB_* vars are set by docker-compose to point at the Postgres
# service (host `postgres`, port 5432) from the PROD_DOTENV secret — see
# /.env.example and DEPLOY.md. No connection string is needed.
#
# Alternatively, a single DATABASE_URL takes precedence over the DB_* vars and
# auto-enables SSL — use it only for a managed Postgres that requires TLS:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── HTTP server ──────────────────────────────────────────────────────────
# Port the API listens on (in the VPS container it's 3000; locally 3001).
PORT=3001
# Comma-separated allowed browser origins (no trailing slash / path). Not needed
# in production (the web nginx proxies /api same-origin). Local Vite dev server:
CORS_ORIGIN=http://localhost:5173

# ── Admin dashboard login ────────────────────────────────────────────────
# Gates the guest list + invitations. Public /i/<slug> invites need no login.
# For local dev these can be anything; in prod set strong values in PROD_DOTENV.
# Without ADMIN_PASSWORD the login is disabled (no one can sign in).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=wedding
# Signs the session cookie — any long random string; keep it stable.
AUTH_SECRET=dev-secret-change-me
