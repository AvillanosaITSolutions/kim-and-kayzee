# Production build config for the web app (loaded automatically by `vite build`).
#
# The app is served SAME-ORIGIN on the VPS: nginx serves the SPA and proxies /api
# to the API container, so the browser only ever talks to its own host. Leave
# VITE_API_URL empty — the app calls a relative `/api`. (The Docker build also sets
# this empty; kept here so a plain `pnpm --filter @wedding/web build` matches prod.)
VITE_API_URL=
