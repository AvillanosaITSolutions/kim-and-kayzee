# LOCAL DEV ONLY.
#
# For local dev you don't need this file at all — leave VITE_API_URL empty and
# the Vite proxy forwards /api to the NestJS server on localhost:3001.
#
# Production is already wired up in `.env.production` (committed): it points the
# built site at the deployed Render API. You normally never touch that.
#
# Set this only to test the web app against a remote API locally (no trailing
# slash — the app appends `/api`):
VITE_API_URL=

# Base path of the built site. Defaults to /kim-and-kayzee/ for GitHub Pages.
# Set to / only for a custom domain or a <user>.github.io user page.
# VITE_BASE=/kim-and-kayzee/
