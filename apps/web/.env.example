# LOCAL DEV ONLY.
#
# For local dev you don't need this file at all — leave VITE_API_URL empty and
# the Vite proxy forwards /api to the NestJS server on localhost:3001.
#
# Production is same-origin (nginx proxies /api on the VPS), already wired up in
# `.env.production` (VITE_API_URL empty). You normally never touch that.
#
# Set this only to test the web app against a remote API locally (no trailing
# slash — the app appends `/api`):
VITE_API_URL=

# Base path of the built site. Defaults to / (served at the domain root on the
# VPS). Set it only if you host the app under a subpath.
# VITE_BASE=/
