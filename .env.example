# PROD_DOTENV template — the production .env that lives ONLY on the VPS.
#
# This is NOT for local dev (for that, see apps/api/.env.example — the api/web run
# from `pnpm dev`, and `pnpm db:up` starts just Postgres). This file is the whole
# contents of the GitHub secret PROD_DOTENV: docker compose reads it on the VPS.
# Copy it, fill in the values, and paste the result into the secret (see DEPLOY.md).

# --- Postgres (used by the postgres, api and seed) ---
# Use a STRONG password on the VPS (e.g. `openssl rand -base64 24`).
POSTGRES_USER=wedding
POSTGRES_PASSWORD=wedding
POSTGRES_DB=wedding

# --- HTTPS front door (all OPTIONAL) ---
# Leave KK_HOST blank and the deploy derives a hostname from the box's public IP via
# sslip.io, prefixed "kim." so it stays distinct from the auto-checkout-bot back
# office on the same Traefik — e.g. kim.72-62-125-235.sslip.io. Set it only to use a
# domain you own (add an A record → 72.62.125.235, then set KK_HOST=<your-host>).
KK_HOST=
# Let's Encrypt account contact. Defaults to acme@$KK_HOST; never verified.
ACME_EMAIL=
# Point at the Let's Encrypt STAGING CA to rehearse issuance without the real rate
# limit. Blank = the real CA. Switching CAs needs the acme.json wiped first:
#   docker run --rm -v edge_letsencrypt:/le busybox rm -f /le/acme.json
ACME_CA_SERVER=

# --- Port bindings (OPTIONAL) ---
# Where the web app's plaintext :8081 is published. Default 0.0.0.0 keeps it
# reachable as a fallback if a cert ever fails to renew; set 127.0.0.1 to go
# HTTPS-only once you trust the Traefik front door.
WEB_BIND=
# Where Postgres :5433 is published. Default 127.0.0.1 (loopback) — the API reaches
# the DB over the compose network, so this only needs opening for a seed/tunnel.
DB_BIND=

# --- CORS (OPTIONAL) ---
# The web nginx proxies /api server-side (same-origin), so CORS is normally not
# needed. Set this only if another origin calls the API directly. No trailing slash.
# CORS_ORIGIN=https://kim.72-62-125-235.sslip.io
